# Copy this file to .env.docker to run the app via docker compose up.
# Points at containerized Postgres/Redis, not hosted Supabase.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/rtc_dev
REDIS_URL=redis://redis:6379
PORT=4000
JWT_ACCESS_SECRET=REPLACE_ME_LOCAL_DOCKER_ONLY
JWT_REFRESH_SECRET=REPLACE_ME_LOCAL_DOCKER_ONLY
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
